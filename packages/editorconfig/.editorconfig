root = true

[*]
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 2

# Matches yamllint line-length
[*.{yml,yaml}]
max_line_length = 100

# JavaScript/TypeScript settings
[*.{js,ts,jsx,tsx}]
max_line_length = 100

# Markdown settings
[*.md]
trim_trailing_whitespace = false

# Lua settings (stylua column width)
[*.lua]
max_line_length = 120

# Go: gofmt uses tabs
[*.go]
indent_style = tab

# .NET conventions
[*.{cs,csx}]
indent_size = 4

# PEP 8
[*.py]
indent_size = 4

# Trailing whitespace and missing final newlines are significant in patches
[*.{diff,patch}]
trim_trailing_whitespace = false
insert_final_newline = false

# Make recipes require tabs
[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab

[{.gitconfig,.gitconfig-*,.gitalias,.config/git/config}]
indent_style = tab
indent_size = 4
